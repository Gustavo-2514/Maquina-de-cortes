#!/usr/bin/env bash
# Validates the commit message against Conventional Commits (see CONTRIBUTING.md).
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -1)"

# Messages generated by git itself
if [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"

fail() {
  printf '\n\033[31m✗ Invalid commit message:\033[0m %s\n  %s\n\n' "$subject" "$1" >&2
  printf '  Expected: <type>(<optional scope>): <description in English>\n' >&2
  printf '  Types:    %s\n' "${types//|/, }" >&2
  printf '  Example:  feat(editor): add zoom to the timeline\n\n' >&2
  printf '  See CONTRIBUTING.md for details.\n\n' >&2
  exit 1
}

[[ "$subject" =~ $pattern ]] || fail "It does not follow Conventional Commits."
(( ${#subject} <= 72 )) || fail "The first line has ${#subject} characters (max 72)."
[[ "$subject" =~ \.$ ]] && fail "Do not end the first line with a period."

if LC_ALL=C grep -q '[^ -~]' <<<"$subject"; then
  printf '\033[33m! The first line has accented or non-ASCII characters. Commits must be written in English.\033[0m\n' >&2
fi
exit 0
